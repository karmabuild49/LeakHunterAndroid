<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<meta name="color-scheme" content="dark">
<title>LeakHunter v2.0</title>
<style>
:root{--green:#00ff75;--green2:#00b95b;--cyan:#76ffe1;--red:#ff5364;--bg:#020604;--panel:#07130d;--line:#124b2c}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top,#062314 0%,#020604 52%);color:#c5ffe0;font:14px ui-monospace,SFMono-Regular,Consolas,monospace;min-height:100vh}
body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.09;background:repeating-linear-gradient(0deg,transparent 0 3px,#00ff75 4px,transparent 5px 7px);animation:flicker 7s linear infinite}
@keyframes flicker{0%,100%{opacity:.06}50%{opacity:.12}}@keyframes pulse{0%,100%{box-shadow:0 0 5px #00ff7540}50%{box-shadow:0 0 20px #00ff7570}}
header{padding:24px 18px 18px;border-bottom:1px solid var(--line);background:#020805d9}
.brand{font-size:clamp(25px,7vw,40px);font-weight:900;letter-spacing:-2px;color:var(--green);text-shadow:0 0 18px #00ff7570}.sub{color:var(--cyan);letter-spacing:3px;margin-top:6px;font-size:11px}
.wrap{padding:16px;max-width:900px;margin:auto}.status{display:flex;justify-content:space-between;gap:10px;color:var(--green);font-size:11px;margin:4px 0 16px}
.panel{background:linear-gradient(145deg,#08170eeb,#030805f5);border:1px solid var(--line);border-radius:12px;padding:16px;margin-bottom:14px;box-shadow:0 0 18px #00ff7508}
h2{font-size:14px;color:var(--green);margin:0 0 14px;letter-spacing:1px}.field{width:100%;padding:14px;background:#020805;border:1px solid #17623a;border-radius:8px;color:var(--cyan);font:inherit;outline:none}.field:focus{border-color:var(--green);box-shadow:0 0 12px #00ff7530}
button{width:100%;padding:14px;border:1px solid var(--green);border-radius:8px;background:var(--green);color:#001b0c;font:900 13px inherit;letter-spacing:1px;margin-top:10px;animation:pulse 3s infinite}button:disabled{opacity:.6}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.tile{border:1px solid var(--line);background:#041008;border-radius:9px;padding:12px}.tile strong{display:block;color:var(--green);font-size:21px;margin-bottom:5px}.tile span{font-size:10px;color:#9ed9b6}
.log{white-space:pre-wrap;overflow-wrap:anywhere;min-height:70px;color:var(--green);font-size:11px;line-height:1.7}.result{font-size:11px;line-height:1.6;overflow-wrap:anywhere}details{border-top:1px solid #124b2c;padding:10px 0}summary{color:var(--cyan);cursor:pointer}.host{padding:10px 0;border-bottom:1px dashed #124b2c}.host b{color:var(--green)}.muted{color:#78a98a;font-size:10px;line-height:1.6}.foot{text-align:center;color:#43865c;font-size:10px;padding:16px}
</style>
</head>
<body>
<header><div class="brand">LEAKHUNTER <small style="font-size:13px;color:#d4ffea">v2.0</small></div><div class="sub">FIND · ANALYZE · PROTECT</div></header>
<div class="wrap">
<div class="status"><span>● DEFENSIVE SCAN CONSOLE</span><span id="state">SYSTEM READY</span></div>
<section class="panel">
<h2>◉ SCAN TARGET</h2>
<input id="domain" class="field" autocomplete="url" autocapitalize="none" spellcheck="false" placeholder="example.com">
<button id="scan" onclick="startScan()">▶ START AUTHORIZED SCAN</button>
<p class="muted">Only scan domains you own or have explicit permission to assess. Uses public certificate records, DNS resolution and basic HTTPS headers.</p>
</section>
<div class="grid">
<div class="tile"><strong id="hosts">—</strong><span>HOSTS FOUND</span></div>
<div class="tile"><strong id="dns">—</strong><span>DNS RESOLVED</span></div>
<div class="tile"><strong id="https">—</strong><span>HTTPS RESPONSES</span></div>
<div class="tile"><strong id="checks">3</strong><span>CHECK CATEGORIES</span></div>
</div>
<section class="panel" style="margin-top:14px"><h2>⌁ LIVE SCAN LOG</h2><div id="log" class="log">[+] LeakHunter mobile console initialized.\n[+] Waiting for authorized target...</div></section>
<section class="panel"><h2>▣ SCAN RESULTS</h2><div id="results" class="result muted">No scan results yet.</div></section>
<section class="panel"><h2>⇩ REPORT</h2><button onclick="exportReport()">SAVE JSON REPORT</button><p class="muted">Exports the results shown in this session. No data is uploaded to a LeakHunter server.</p></section>
<div class="foot">REAL DATA / REAL RISKS / BETTER SECURITY<br>ANONYMOUS-INSPIRED VISUAL THEME · NOT AFFILIATED WITH ANONYMOUS</div>
</div>
<script>
let lastReport=null;
function log(s){const el=document.getElementById('log');el.textContent += '\n'+s;el.scrollTop=el.scrollHeight;}
function startScan(){
 const d=document.getElementById('domain').value.trim();
 if(!d){alert('Enter a domain you own or are authorized to test.');return;}
 document.getElementById('scan').disabled=true;document.getElementById('state').textContent='SCANNING...';
 document.getElementById('log').textContent='[+] Initializing scan...\n[+] Querying public certificate transparency records...\n[+] Checking DNS and HTTPS headers...';
 document.getElementById('results').textContent='Scan in progress...';
 if(window.LeakHunter && window.LeakHunter.scanDomain){window.LeakHunter.scanDomain(d,'scan1');}
 else {document.getElementById('scan').disabled=false;document.getElementById('state').textContent='ERROR';log('[-] Native scanner unavailable.');}
}
window.onNativeScanResult=function(callback,jsonText){
 const r=JSON.parse(jsonText);lastReport=r;
 document.getElementById('scan').disabled=false;document.getElementById('state').textContent=r.status==='ok'?'SCAN COMPLETE':'SCAN ERROR';
 if(r.status!=='ok'){log('[-] '+r.message);document.getElementById('results').textContent=r.message||'Scan failed';return;}
 document.getElementById('hosts').textContent=r.hostCount;document.getElementById('dns').textContent=r.dnsResolved;document.getElementById('https').textContent=r.httpsResponded;
 log('[+] Found '+r.hostCount+' hostnames');log('[+] DNS resolved for '+r.dnsResolved+' hosts');log('[+] HTTPS responded for '+r.httpsResponded+' hosts');log('[+] Scan completed. Review findings below.');
 let html='<p><b>Target:</b> '+escapeHtml(r.domain)+'</p><p><b>Hosts:</b> '+r.hostCount+' · <b>DNS:</b> '+r.dnsResolved+' · <b>HTTPS:</b> '+r.httpsResponded+'</p>';
 html+='<p class="muted">'+escapeHtml(r.note||'')+'</p>';
 (r.hosts||[]).forEach(h=>{html+='<details class="host"><summary>'+escapeHtml(h.host)+' — DNS '+escapeHtml(h.dns||'unknown')+'</summary><p>Addresses: '+escapeHtml((h.addresses||[]).join(', ')||'None returned')+'</p><p>HTTPS status: '+escapeHtml(String(h.httpsStatus||h.https||'not checked'))+'</p><p>HSTS: '+(h.hsts?'present':'missing/unknown')+' · CSP: '+(h.csp?'present':'missing/unknown')+' · X-Content-Type-Options: '+(h.xContentTypeOptions?'present':'missing/unknown')+'</p></details>';});
 document.getElementById('results').innerHTML=html;
};
function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function exportReport(){if(!lastReport){alert('Run a scan first.');return;}if(window.LeakHunter&&window.LeakHunter.shareReport){window.LeakHunter.shareReport(JSON.stringify(lastReport,null,2));}else{alert('Report export is unavailable.');}}
</script>
</body>
</html>
